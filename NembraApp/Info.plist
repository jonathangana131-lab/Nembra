    <key>NembraCaptureBuildInstanceID</key>
    <string>$(NEMBRA_CAPTURE_BUILD_INSTANCE_ID)</string>
    <key>NembraCaptureBuildCommitSHA</key>
    <string>$(NEMBRA_CAPTURE_BUILD_COMMIT_SHA)</string>
    <key>NembraCaptureFieldRecipe</key>
    <string>$(NEMBRA_CAPTURE_FIELD_RECIPE)</string>
