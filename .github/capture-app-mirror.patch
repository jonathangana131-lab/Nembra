+    /// Mirrors the bounded incomplete-evidence result already committed by the package mutation
+    /// that threw `incompleteObservationHorizonReached`. The package has already frozen the
+    /// accepted prefix and retired callback authority, so app presentation must not attempt a
+    /// second ledger mutation, advance the clock, or invent a Bluetooth disconnect.
+    private func mirrorAlreadyTerminalIncompleteObservationHorizon(
+        token: TuyaReadOnlyConnectionToken,
+        message: String,
+        kind: String
+    ) async {
+        guard currentConnectionToken == token else { return }
+        watchdog?.cancel()
+        watchdog = nil
+        currentConnectionToken = nil
+        localBLESettlementToken = nil
+        sdkLocalBLEOnline = false
+        driver = nil
+        await refreshLedgerSnapshot()
+        phase = .failed
+        self.message = message
+        log(kind, ["generation": String(token.diagnosticGeneration)])
+    }
